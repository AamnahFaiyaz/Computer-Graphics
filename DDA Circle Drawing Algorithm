#include <GL/glut.h>
#include <math.h>

// Initialize the 2D display area
void myInit() {
    glClearColor(1.0, 1.0, 1.0, 1.0); // White background
    glColor3f(0.0, 0.0, 0.0);          // Black drawing color
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(0.0, 500.0, 0.0, 500.0); // Coordinates: X (0 to 500), Y (0 to 500)
}

// Function to draw a basic circle using trigonometric formulas
void drawCircle(float xc, float yc, float r) {
    glBegin(GL_LINE_LOOP);
    for (int i = 0; i < 360; i++) {
        float theta = i * 3.14159 / 180; // Convert degrees to radians
        float x = xc + r * cos(theta);
        float y = yc + r * sin(theta);
        glVertex2f(x, y);
    }
    glEnd();
}

// Function to draw shapes on screen
void display() {
    glClear(GL_COLOR_BUFFER_BIT); // Clear the screen

    // 1. DRAWING POINTS
    glPointSize(5.0); // Set point size
    glBegin(GL_POINTS);
        glVertex2i(50, 400);
        glVertex2i(100, 400);
        glVertex2i(150, 400);
    glEnd();

    // 2. DRAWING A LINE
    glLineWidth(3.0); // Set line width
    glBegin(GL_LINES);
        glVertex2i(50, 300);  // Starting point (x1, y1)
        glVertex2i(250, 300); // Ending point (x2, y2)
    glEnd();

    // 3. DRAWING A CIRCLE
    // Center = (350, 200), Radius = 60
    drawCircle(350, 200, 60);

    glFlush(); // Send output to screen
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(500, 500);       // Window resolution
    glutInitWindowPosition(100, 100);   // Window position on screen
    glutCreateWindow("BCA Lab: Basic Shapes");
    
    myInit();
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}

