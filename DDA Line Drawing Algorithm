#include <GL/glut.h>
#include <iostream>
#include <cmath>

// Global variables for line coordinates
float x_1, y_1, x_2, y_2;

void drawDDA() {
    float dx = x_2 - x_1;
    float dy = y_2 - y_1;

    // Find steps required
    float steps = std::max(std::abs(dx), std::abs(dy));

    // Calculate increments per step
    float xInc = dx / steps;
    float yInc = dy / steps;

    float x = x_1;
    float y = y_1;

    glClear(GL_COLOR_BUFFER_BIT);
    glColor3f(1.0, 1.0, 1.0); // White color

    glBegin(GL_POINTS);
    for (int i = 0; i <= steps; i++) {
        // Round floating values to plot closest pixel
        glVertex2i(std::round(x), std::round(y)); 
        x += xInc;
        y += yInc;
    }
    glEnd();

    glFlush();
}

void init() {
    glClearColor(0.0, 0.0, 0.0, 1.0); // Black background
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(0, 500, 0, 500);       // 2D orthographic view (0 to 500)
}

int main(int argc, char** argv) {
    std::cout << "Enter x1 y1 x2 y2: ";
    std::cin >> x_1 >> y_1 >> x_2 >> y_2;

    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(500, 500);
    glutInitWindowPosition(100, 100);
    glutCreateWindow("DDA Line Algorithm");

    init();
    glutDisplayFunc(drawDDA);
    glutMainLoop();

    return 0;
}

