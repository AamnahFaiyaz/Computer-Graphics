#include <GL/glut.h>

// Define 2D point structure
typedef struct {
    float x;
    float y;
} Point2D;

// Original square coordinates centered at (0,0)
Point2D originalSquare[4] = {
    {-0.2f, -0.2f}, // Bottom-Left
    { 0.2f, -0.2f}, // Bottom-Right
    { 0.2f,  0.2f}, // Top-Right
    {-0.2f,  0.2f}  // Top-Left
};

// Translation offsets: Shift X right by 0.5, Shift Y up by 0.4
float tx = 0.5f;
float ty = 0.4f;

// Function to translate a point (x' = x + tx, y' = y + ty)
Point2D translatePoint(Point2D p, float dx, float dy) {
    Point2D translatedP;
    translatedP.x = p.x + dx;
    translatedP.y = p.y + dy;
    return translatedP;
}

void display() {
    glClear(GL_COLOR_BUFFER_BIT);

    // 1. Draw ORIGINAL shape at (0, 0) in GRAY
    glColor3f(0.5f, 0.5f, 0.5f);
    glBegin(GL_QUADS);
    for (int i = 0; i < 4; i++) {
        glVertex2f(originalSquare[i].x, originalSquare[i].y);
    }
    glEnd();

    // 2. Draw TRANSLATED shape in BLUE
    glColor3f(0.2f, 0.6f, 1.0f);
    glBegin(GL_QUADS);
    for (int i = 0; i < 4; i++) {
        // Calculate new coordinate for each vertex
        Point2D newPoint = translatePoint(originalSquare[i], tx, ty);
        glVertex2f(newPoint.x, newPoint.y);
    }
    glEnd();

    glFlush();
}

void init() {
    glClearColor(0.1f, 0.1f, 0.1f, 1.0f); // Dark background
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(-1.0, 1.0, -1.0, 1.0);     // 2D coordinate space (-1 to 1)
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(500, 500);
    glutCreateWindow("Simple 2D Translation Formula");

    init();
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}
