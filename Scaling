#include <GL/glut.h>

// Define 2D point structure
typedef struct {
    float x;
    float y;
} Point2D;

// Original square coordinates centered around the origin (0,0)
Point2D originalSquare[4] = {
    {-0.2f, -0.2f}, // Bottom-Left
    { 0.2f, -0.2f}, // Bottom-Right
    { 0.2f,  0.2f}, // Top-Right
    {-0.2f,  0.2f}  // Top-Left
};

// Scaling factors: Enlarge width by 2.0x and height by 2.0x
float sx = 2.0f;
float sy = 2.0f;

// Function to scale a point: x' = x * sx, y' = y * sy
Point2D scalePoint(Point2D p, float scaleX, float scaleY) {
    Point2D scaledP;
    scaledP.x = p.x * scaleX;
    scaledP.y = p.y * scaleY;
    return scaledP;
}

void display() {
    glClear(GL_COLOR_BUFFER_BIT);

    // 1. Draw ORIGINAL shape (Gray) - 1.0x scale
    glColor3f(0.5f, 0.5f, 0.5f);
    glBegin(GL_QUADS);
    for (int i = 0; i < 4; i++) {
        glVertex2f(originalSquare[i].x, originalSquare[i].y);
    }
    glEnd();

    // 2. Draw SCALED shape (Green) - 2.0x scale
    glColor3f(0.2f, 0.9f, 0.3f);
    glBegin(GL_QUADS);
    for (int i = 0; i < 4; i++) {
        // Apply scaling formula to each vertex
        Point2D newPoint = scalePoint(originalSquare[i], sx, sy);
        glVertex2f(newPoint.x, newPoint.y);
    }
    glEnd();

    glFlush();
}

void init() {
    glClearColor(0.1f, 0.1f, 0.1f, 1.0f); // Dark background
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(-1.0, 1.0, -1.0, 1.0);     // Set 2D orthographic bounds (-1 to 1)
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(500, 500);
    glutCreateWindow("Simple 2D Scaling Formula");

    init();
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}
