#include <GL/glut.h>
#include <cstdlib>
#include <cmath>

// Traffic signal states
enum Signal {
    RED = 0,
    GREEN = 1,
    YELLOW = 2
};

int currentSignal = RED;
bool paused = false;

// Function to draw a circle
void drawCircle(float cx, float cy, float radius,
                float r, float g, float b) {

    glColor3f(r, g, b);

    glBegin(GL_TRIANGLE_FAN);

    glVertex2f(cx, cy);

    for (int i = 0; i <= 100; ++i) {

        float angle = 2.0f * 3.1415926f * i / 100.0f;

        glVertex2f(
            cx + radius * cosf(angle),
            cy + radius * sinf(angle)
        );
    }

    glEnd();
}

// Function to display text
void drawText(float x, float y, const char* text) {

    glColor3f(0.92f, 0.94f, 0.98f);

    glRasterPos2f(x, y);

    for (const char* c = text; *c; ++c) {
        glutBitmapCharacter(
            GLUT_BITMAP_HELVETICA_18, *c
        );
    }
}

// Display function
void display() {

    glClear(GL_COLOR_BUFFER_BIT);

    // Background
    glColor3f(0.07f, 0.10f, 0.16f);

    glBegin(GL_QUADS);

        glVertex2f(-1.0f, -1.0f);
        glVertex2f( 1.0f, -1.0f);
        glVertex2f( 1.0f,  1.0f);
        glVertex2f(-1.0f,  1.0f);

    glEnd();

    // Road
    glColor3f(0.12f, 0.14f, 0.18f);

    glBegin(GL_QUADS);

        glVertex2f(-1.0f, -0.90f);
        glVertex2f( 1.0f, -0.90f);
        glVertex2f( 1.0f, -0.65f);
        glVertex2f(-1.0f, -0.65f);

    glEnd();

    // Road marking
    glColor3f(0.75f, 0.78f, 0.82f);

    glBegin(GL_LINES);

        glVertex2f(-1.0f, -0.78f);
        glVertex2f( 1.0f, -0.78f);

    glEnd();

    // Traffic light pole
    glColor3f(0.34f, 0.39f, 0.48f);

    glBegin(GL_QUADS);

        glVertex2f(-0.06f, -0.68f);
        glVertex2f( 0.06f, -0.68f);
        glVertex2f( 0.06f, -0.25f);
        glVertex2f(-0.06f, -0.25f);

    glEnd();

    // Traffic light housing
    glColor3f(0.10f, 0.13f, 0.19f);

    glBegin(GL_QUADS);

        glVertex2f(-0.25f, -0.25f);
        glVertex2f( 0.25f, -0.25f);
        glVertex2f( 0.25f,  0.88f);
        glVertex2f(-0.25f,  0.88f);

    glEnd();

    // Dim colour for inactive lights
    const float dim = 0.16f;

    // RED LIGHT
    drawCircle(
        0.0f, 0.62f, 0.16f,
        currentSignal == RED ? 1.0f : dim,
        currentSignal == RED ? 0.05f : 0.02f,
        currentSignal == RED ? 0.05f : 0.02f
    );

    // YELLOW LIGHT
    drawCircle(
        0.0f, 0.30f, 0.16f,
        currentSignal == YELLOW ? 1.0f : dim,
        currentSignal == YELLOW ? 0.82f : dim,
        currentSignal == YELLOW ? 0.05f : 0.02f
    );

    // GREEN LIGHT
    drawCircle(
        0.0f, -0.02f, 0.16f,
        currentSignal == GREEN ? 0.05f : 0.02f,
        currentSignal == GREEN ? 1.0f : dim,
        currentSignal == GREEN ? 0.12f : 0.02f
    );

    // Display project title
    drawText(-0.88f, 0.86f,
             "TRAFFIC LIGHT SIMULATION");

    // Display control instructions
    if (paused) {

        drawText(-0.88f, 0.72f,
                 "PAUSED - Press SPACE to Resume");

    } else {

        drawText(-0.88f, 0.72f,
                 "SPACE: Pause/Resume  R: Reset  ESC: Exit");
    }

    glFlush();
}

// Timer function for automatic signal switching
void timer(int value) {

    if (!paused) {

        // Sequence: RED -> GREEN -> YELLOW -> RED
        currentSignal = (currentSignal + 1) % 3;

        glutPostRedisplay();
    }

    // Set duration for each signal
    int delay = (currentSignal == YELLOW) ? 2000 : 4000;

    glutTimerFunc(delay, timer, 0);
}

// Keyboard interaction
void keyboard(unsigned char key, int x, int y) {

    // Exit
    if (key == 27) {
        std::exit(0);
    }

    // Pause or Resume
    if (key == ' ' || key == 'p' || key == 'P') {

        paused = !paused;

        glutPostRedisplay();
    }

    // Reset traffic signal
    if (key == 'r' || key == 'R') {

        currentSignal = RED;
        paused = false;

        glutPostRedisplay();
    }
}

// Window resizing function
void reshape(int width, int height) {

    glViewport(0, 0, width, height);

    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();

    gluOrtho2D(-1.0, 1.0, -1.0, 1.0);

    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();
}

// Main function
int main(int argc, char** argv) {

    // Initialize GLUT
    glutInit(&argc, argv);

    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);

    glutInitWindowSize(700, 700);
    glutInitWindowPosition(100, 100);

    // Create window
    glutCreateWindow(
        "Traffic Light Simulation using OpenGL"
    );

    // Background colour
    glClearColor(0.07f, 0.10f, 0.16f, 1.0f);

    // Register callback functions
    glutDisplayFunc(display);
    glutReshapeFunc(reshape);
    glutKeyboardFunc(keyboard);

    // Start timer (initial RED signal: 4 seconds)
    glutTimerFunc(4000, timer, 0);

    // Start main event loop
    glutMainLoop();

    return 0;
}
